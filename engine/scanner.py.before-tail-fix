# ============================================================
# CONSTANTS
# ============================================================

DEFAULT_TIMEOUT = 10
DEFAULT_TEMPLATE_DIR = "templates"

VALID_KINDS = {
    "Verified",
    "Possible",
    "Related",
    "Investigation",
}

SEVERITY_MAP = {
    "critical": "Critical",
    "high": "High",
    "medium": "Medium",
    "low": "Low",
    "info": "Informational",
    "informational": "Informational",
}

DEFAULT_USER_AGENT = "VulnForge/1.0 Security Scanner"


# ============================================================
# HELPERS
# ============================================================

def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def normalize_severity(value: Any) -> str:
    value = str(value or "info").strip().lower()
    return SEVERITY_MAP.get(value, "Informational")


def safe_int(value: Any, default: int = 0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def safe_float(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def ensure_list(value: Any) -> List[Any]:
    if value is None:
        return []

    if isinstance(value, list):
        return value

    return [value]


# ============================================================
# RESULT OBJECTS
# ============================================================

@dataclass
class ScanResult:
    findings: List[Dict[str, Any]] = field(default_factory=list)

    request_count: int = 0
    error_count: int = 0

    templates_loaded: int = 0
    templates_executed: int = 0

    start_time: Optional[str] = None
    end_time: Optional[str] = None

    duration: float = 0.0

    scan_id: Optional[str] = None
    target: Optional[str] = None

    fingerprint: Dict[str, Any] = field(default_factory=dict)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "scan_id": self.scan_id,
            "target": self.target,
            "findings": self.findings,
            "request_count": self.request_count,
            "error_count": self.error_count,
            "templates_loaded": self.templates_loaded,
            "templates_executed": self.templates_executed,
            "start_time": self.start_time,
            "end_time": self.end_time,
            "duration": self.duration,
            "fingerprint": self.fingerprint,
        }

    def __getitem__(self, key: str) -> Any:
        return self.to_dict()[key]


@dataclass
class ResponseData:
    status: int
    headers: Dict[str, str]
    body: str
    elapsed: float
    url: str
    method: str

    @property
    def text(self) -> str:
        return self.body

    @property
    def header_text(self) -> str:
        return "\n".join(
            f"{key}: {value}"
            for key, value in self.headers.items()
        )

    @property
    def all_text(self) -> str:
        return self.header_text + "\n\n" + self.body

    def header(self, name: str) -> Optional[str]:
        wanted = str(name).lower()

        for key, value in self.headers.items():
            if key.lower() == wanted:
                return value

        return None


# ============================================================
# SCANNER
# ============================================================

class Scanner:

    def __init__(
        self,
        url: str,
        quiet: bool = False,
        template_dir: str = DEFAULT_TEMPLATE_DIR,
        max_workers: int = 5,
        proxy_file: Optional[str] = None,
        country: Optional[str] = None,
        rate_limit: float = 0,
        delay: float = 0,
        jitter: float = 0,
        exploit: bool = False,
        username: Optional[str] = None,
        password: Optional[str] = None,
        timeout: int = DEFAULT_TIMEOUT,
        skip_priv: bool = False,
        skip_auth: bool = False,
        no_fingerprint: bool = False,
    ) -> None:

        # ----------------------------------------------------
        # TARGET
        # ----------------------------------------------------

        self.raw_url = str(url).strip().rstrip("/")

        # Protect against accidentally passing markdown links
        self.raw_url = re.sub(
            r"^\[([^\]]+)\]\((https?://[^)]+)\)$",
            r"\2",
            self.raw_url,
        )

        if not self.raw_url.startswith(
            ("http://", "https://")
        ):
            self.raw_url = "https://" + self.raw_url

        parsed = urlparse(self.raw_url)

        self.base_url = (
            f"{parsed.scheme}://{parsed.netloc}"
        )

        # ----------------------------------------------------
        # OPTIONS
        # ----------------------------------------------------

        self.quiet = bool(quiet)

        self.template_dir = Path(template_dir)

        self.max_workers = max(
            1,
            safe_int(max_workers, 5),
        )

        self.proxy_file = proxy_file
        self.preferred_country = country

        self.rate_limit = max(
            0.0,
            safe_float(rate_limit),
        )

        self.base_delay = max(
            0.0,
            safe_float(delay),
        )

        self.jitter = max(
            0.0,
            safe_float(jitter),
        )

        self.exploit_enabled = bool(exploit)

        self.timeout = max(
            1,
            safe_int(timeout, DEFAULT_TIMEOUT),
        )

        self.skip_priv = bool(skip_priv)
        self.skip_auth = bool(skip_auth)
        self.no_fingerprint = bool(no_fingerprint)

        self.username = username
        self.password = password

        # ----------------------------------------------------
        # TELEMETRY
        # ----------------------------------------------------

        self.requests_sent = 0
        self.errors_count = 0

        self.templates: List[Dict[str, Any]] = []
        self.findings: List[Dict[str, Any]] = []

        self.scan_id = datetime.now().strftime(
            "%Y%m%d_%H%M%S_%f"
        )[:-3]

        # ----------------------------------------------------
        # THREAD SAFETY
        # ----------------------------------------------------

        self._counter_lock = threading.Lock()
        self._rate_lock = threading.Lock()

        self.last_request_time = 0.0

        # ----------------------------------------------------
        # CONTEXT
        # ----------------------------------------------------

        self.context: Dict[str, Any] = {
            "BaseURL": self.base_url,
            "base_url": self.base_url,
            "RootURL": self.base_url,
            "root_url": self.base_url,
            "Hostname": parsed.hostname or "",
            "host": parsed.hostname or "",
            "interactsh-url": "oob.vulnforge.com",
        }

        # ----------------------------------------------------
        # HTTP SESSION
        # ----------------------------------------------------

        self.session = requests.Session()

        self.session.headers.update(
            {
                "User-Agent": DEFAULT_USER_AGENT,
                "Accept": "*/*",
            }
        )

        # ----------------------------------------------------
        # AUTH
        # ----------------------------------------------------

        self.authenticated = False

        # ----------------------------------------------------
        # FINGERPRINT
        # ----------------------------------------------------

        self.fingerprint_data: Dict[str, Any] = {}

        # ----------------------------------------------------
        # RUNTIME
        # ----------------------------------------------------

        self.start_time: Optional[str] = None
        self.end_time: Optional[str] = None

        # ----------------------------------------------------
        # BLOCK DETECTION
        # ----------------------------------------------------

        self.block_patterns = [
            "cf-challenge",
            "one moment, please",
            "checking your browser",
            "captcha",
            "cloudflare",
            "ddos protection",
            "please wait",
            "access denied",
            "site is down",
            "offline",
            "maintenance mode",
            "under maintenance",
        ]

    # ========================================================
    # LOGGING
    # ========================================================

    def _log(self, message: str) -> None:
        if not self.quiet:
            print(message)

    # ========================================================
    # PROXY
    # ========================================================

    def _load_proxy(self) -> Optional[str]:

        if not self.proxy_file:
            return None

        path = Path(self.proxy_file)

        if not path.exists():
            self._log(
                f"[WARN] Proxy file not found: {path}"
            )
            return None

        try:
            lines = [
                line.strip()
                for line in path.read_text(
                    encoding="utf-8"
                ).splitlines()
                if line.strip()
                and not line.lstrip().startswith("#")
            ]

            if not lines:
                return None

            return random.choice(lines)

        except OSError as exc:
            logger.warning(
                "Unable to read proxy file: %s",
                exc,
            )
            return None

    # ========================================================
    # RATE LIMIT
    # ========================================================

    def _wait_before_request(self) -> None:

        with self._rate_lock:

            now = time.monotonic()

            if self.rate_limit > 0:

                minimum_interval = (
                    1.0 / self.rate_limit
                )

                elapsed = (
                    now - self.last_request_time
                )

                if elapsed < minimum_interval:
                    time.sleep(
                        minimum_interval - elapsed
                    )

            if self.base_delay > 0:

                delay = self.base_delay

                if self.jitter > 0:
                    delay += random.uniform(
                        0,
                        self.jitter,
                    )

                time.sleep(delay)

            self.last_request_time = (
                time.monotonic()
            )

    # ========================================================
    # COUNTERS
    # ========================================================

    def _increment_requests(self) -> None:

        with self._counter_lock:
            self.requests_sent += 1

    def _increment_errors(self) -> None:

        with self._counter_lock:
            self.errors_count += 1

    # ========================================================
    # TEMPLATE LOADING
    # ========================================================

    def load_templates(
        self,
    ) -> List[Dict[str, Any]]:

        self.templates = []

        if not self.template_dir.exists():

            self._log(
                "[WARN] Template directory not found: "
                f"{self.template_dir}"
            )

            return self.templates

        files = sorted(
            [
                *self.template_dir.rglob("*.yaml"),
                *self.template_dir.rglob("*.yml"),
            ]
        )

        for path in files:

            if not path.is_file():
                continue

            try:

                raw = path.read_text(
                    encoding="utf-8"
                )

                data = yaml.safe_load(raw)

                if not isinstance(data, dict):

                    logger.warning(
                        "Skipping invalid template: %s",
                        path,
                    )

                    continue

                template = self._normalize_template(
                    data,
                    path,
                )

                if template is None:
                    continue

                self.templates.append(template)

            except yaml.YAMLError as exc:

                logger.warning(
                    "Invalid YAML %s: %s",
                    path,
                    exc,
                )

            except OSError as exc:

                logger.warning(
                    "Unable to read %s: %s",
                    path,
                    exc,
                )

            except Exception as exc:

                logger.warning(
                    "Template error %s: %s",
                    path,
                    exc,
                )

        self._log(
            f"[*] Loaded {len(self.templates)} templates"
        )

        return self.templates

    # ========================================================
    # TEMPLATE NORMALIZATION
    # ========================================================

    def _normalize_template(
        self,
        data: Dict[str, Any],
        path: Path,
    ) -> Optional[Dict[str, Any]]:

        template = dict(data)

        template["id"] = str(
            template.get(
                "id",
                path.stem,
            )
        )

        template["name"] = str(
            template.get(
                "name",
                template.get(
                    "info",
                    {}
                ).get(
                    "name",
                    template["id"],
                )
                if isinstance(
                    template.get("info"),
                    dict,
                )
                else template["id"],
            )
        )

        info = template.get("info", {})

        if not isinstance(info, dict):
            info = {}

        template["description"] = str(
            template.get(
                "description",
                info.get(
                    "description",
                    "",
                ),
            )
        )

        template["severity"] = normalize_severity(
            template.get(
                "severity",
                info.get(
                    "severity",
                    "info",
                ),
            )
        )

        template["category"] = str(
            template.get(
                "category",
                info.get(
                    "category",
                    "general",
                ),
            )
        )

        template["impact"] = str(
            template.get(
                "impact",
                info.get(
                    "impact",
                    "",
                ),
            )
        )

        template["recommendation"] = str(
            template.get(
                "recommendation",
                template.get(
                    "remediation",
                    info.get(
                        "remediation",
                        "",
                    ),
                ),
            )
        )

        classification = template.get(
            "classification",
            {},
        )

        if not isinstance(
            classification,
            dict,
        ):
            classification = {}

        template["classification"] = classification

        template["_file"] = str(path)

        # ----------------------------------------------------
        # NUCLEI INFO TAGS
        # ----------------------------------------------------

        template["tags"] = ensure_list(
            template.get(
                "tags",
                info.get("tags", []),
            )
        )

        # ----------------------------------------------------
        # REQUESTS
        # ----------------------------------------------------

        requests_data = template.get(
            "requests"
        )

        # Some templates use http:
        if requests_data is None:
            requests_data = template.get("http")

        if requests_data is not None:

            if not isinstance(
                requests_data,
                list,
            ):

                requests_data = [
                    requests_data
                ]

            normalized_requests = []

            for request_data in requests_data:

                if not isinstance(
                    request_data,
                    dict,
                ):
                    continue

                normalized_requests.append(
                    self._normalize_request(
                        request_data
                    )
                )

            template["requests"] = (
                normalized_requests
            )

        else:

            # ------------------------------------------------
            # Legacy single-request schema
            # ------------------------------------------------

            template["requests"] = [
                self._normalize_request(
                    {
                        "method": template.get(
                            "method",
                            "GET",
                        ),
                        "path": template.get(
                            "path",
                            "/",
                        ),
                        "headers": template.get(
                            "headers",
                            {},
                        ),
                        "body": template.get(
                            "payload",
                            template.get(
                                "body"
                            ),
                        ),
                        "params": template.get(
                            "params",
                            {},
                        ),
                        "matchers": template.get(
                            "matchers",
                            [],
                        ),
                        "extractors": template.get(
                            "extractors",
                            [],
                        ),
                    }
                )
            ]

        if not template["requests"]:

            logger.warning(
                "Skipping template without requests: %s",
                path,
            )

            return None

        return template

    # ========================================================
    # REQUEST NORMALIZATION
    # ========================================================

    def _normalize_request(
        self,
        data: Dict[str, Any],
    ) -> Dict[str, Any]:

        if not isinstance(data, dict):
            return {}

        # ----------------------------------------------------
        # Method
        # ----------------------------------------------------

        method = str(
            data.get(
                "method",
                "GET",
            )
        ).upper()

        # ----------------------------------------------------
        # Path
        # ----------------------------------------------------

        path = data.get(
            "path",
            data.get(
                "url",
                "/",
            ),
        )

        # ----------------------------------------------------
        # Headers
        # ----------------------------------------------------

        headers = data.get(
            "headers",
            {},
        )

        if not isinstance(headers, dict):
            headers = {}

        # ----------------------------------------------------
        # Body
        # ----------------------------------------------------

        body = data.get(
            "body",
            data.get(
                "payload"
            ),
        )

        # ----------------------------------------------------
        # Params
        # ----------------------------------------------------

        params = data.get(
            "params",
            data.get(
                "query",
                {},
            ),
        )

        if not isinstance(params, dict):
            params = {}

        # ----------------------------------------------------
        # Nuclei-style matchers
        #
        # matchers-condition: and
        # matchers:
        #   - type: status
        #     status: [200]
        #
        # OR custom VulnForge:
        #
        # matchers:
        #   - type: body_contains
        #     value: foo
        # ----------------------------------------------------

        matchers = data.get(
            "matchers",
            [],
        )

        if isinstance(matchers, dict):
            matchers = [matchers]

        if not isinstance(matchers, list):
            matchers = []

        # ----------------------------------------------------
        # Also support top-level matcher shorthand
        # ----------------------------------------------------

        shorthand = []

        if "status" in data:
            shorthand.append(
                {
                    "type": "status",
                    "status": data["status"],
                }
            )

        if "words" in data:
            shorthand.append(
                {
                    "type": "word",
                    "words": data["words"],
                    "part": data.get(
                        "part",
                        "body",
                    ),
                    "condition": data.get(
                        "condition",
                        "or",
                    ),
                    "negative": data.get(
                        "negative",
                        False,
                    ),
                }
            )

        if "regex" in data:
            shorthand.append(
                {
                    "type": "regex",
                    "regex": data["regex"],
                    "part": data.get(
                        "part",
                        "body",
                    ),
                    "condition": data.get(
                        "condition",
                        "or",
                    ),
                    "negative": data.get(
                        "negative",
                        False,
                    ),
                }
            )

        matchers = shorthand + matchers

        # ----------------------------------------------------
        # Extractors
        # ----------------------------------------------------

        extractors = data.get(
            "extractors",
            [],
        )

        if isinstance(
            extractors,
            dict,
        ):
            extractors = [extractors]

        if not isinstance(
            extractors,
            list,
        ):
            extractors = []

        # ----------------------------------------------------
        # Condition
        # ----------------------------------------------------

        matcher_condition = data.get(
            "matchers-condition",
            data.get(
                "matchers_condition",
                data.get(
                    "matcher_condition",
                    "or",
                ),
            ),
        )

        matcher_condition = str(
            matcher_condition
        ).lower()

        if matcher_condition not in {
            "and",
            "or",
        }:
            matcher_condition = "or"

        return {
            "method": method,
            "path": str(path),

            "headers": headers,

            "body": body,

            "params": params,

            "matchers": matchers,

            "extractors": extractors,

            "matcher_condition": matcher_condition,

            "stop_at_first_match": bool(
                data.get(
                    "stop_at_first_match",
                    False,
                )
            ),

            "raw": data,
        }

    # ========================================================
    # VARIABLE SUBSTITUTION
    # ========================================================

    def _substitute(
        self,
        value: Any,
        context: Dict[str, Any],
    ) -> Any:

        if isinstance(value, dict):

            return {
                key: self._substitute(
                    val,
                    context,
                )
                for key, val in value.items()
            }

        if isinstance(value, list):

            return [
                self._substitute(
                    item,
                    context,
                )
                for item in value
            ]

        if not isinstance(
            value,
            str,
        ):
            return value

        result = value

        # ----------------------------------------------------
        # Direct replacement
        # ----------------------------------------------------

        for key, val in context.items():

            replacements = [
                "{{" + str(key) + "}}",
                "{{ " + str(key) + " }}",
                "${" + str(key) + "}",
            ]

            for token in replacements:
                result = result.replace(
                    token,
                    str(val),
                )

        return result

    # ========================================================
    # URL BUILDING
    # ========================================================

    def _build_url(
        self,
        path: str,
        context: Dict[str, Any],
    ) -> str:

        path = str(
            self._substitute(
                path,
                context,
            )
        )

        if path.startswith(
            (
                "http://",
                "https://",
            )
        ):
            return path

        return urljoin(
            self.base_url + "/",
            path.lstrip("/"),
        )

    # ========================================================
    # HTTP REQUEST
    # ========================================================

    def _request(
        self,
        method: str,
        url: str,
        headers: Optional[
            Dict[str, Any]
        ] = None,
        body: Any = None,
        params: Optional[
            Dict[str, Any]
        ] = None,
    ) -> Optional[ResponseData]:

        self._wait_before_request()

        request_headers = {
            "User-Agent": DEFAULT_USER_AGENT,
        }

        if headers:

            substituted_headers = (
                self._substitute(
                    headers,
                    self.context,
                )
            )

            if isinstance(
                substituted_headers,
                dict,
            ):

                for key, value in (
                    substituted_headers.items()
                ):

                    request_headers[
                        str(key)
                    ] = str(value)

        # ----------------------------------------------------
        # Body substitution
        # ----------------------------------------------------

        if body is not None:
            body = self._substitute(
                body,
                self.context,
            )

        # ----------------------------------------------------
        # Params substitution
        # ----------------------------------------------------

        if params is not None:
            params = self._substitute(
                params,
                self.context,
            )

        # ----------------------------------------------------
        # Proxy
        # ----------------------------------------------------

        proxies = None

        proxy = self._load_proxy()

        if proxy:

            proxies = {
                "http": proxy,
                "https": proxy,
            }

        started = time.monotonic()

        try:

            response = self.session.request(
                method=method.upper(),
                url=url,
                headers=request_headers,
                data=body,
                params=params,
                timeout=self.timeout,
                allow_redirects=True,
                proxies=proxies,
            )

            elapsed = (
                time.monotonic()
                - started
            )

            self._increment_requests()

            return ResponseData(
                status=response.status_code,
                headers=dict(
                    response.headers
                ),
                body=response.text,
                elapsed=elapsed,
                url=str(response.url),
                method=method.upper(),
            )

        except requests.RequestException as exc:

            self._increment_requests()
            self._increment_errors()

            logger.debug(
                "Request failed: %s",
                exc,
            )

            return None

        except Exception as exc:

            self._increment_requests()
            self._increment_errors()

            logger.debug(
                "Unexpected request error: %s",
                exc,
            )

            return None

    # ========================================================
    # BLOCK DETECTION
    # ========================================================

    def _is_blocked(
        self,
        response: ResponseData,
    ) -> bool:

        body = response.body.lower()

        if response.status in {
            403,
            429,
            503,
        }:

            return any(
                pattern in body
                for pattern in self.block_patterns
            )

        return any(
            pattern in body
            for pattern in self.block_patterns
        )

    # ========================================================
    # MATCHER PART
    # ========================================================

    def _matcher_part(
        self,
        matcher: Dict[str, Any],
        response: ResponseData,
    ) -> str:

        part = str(
            matcher.get(
                "part",
                "body",
            )
        ).lower().strip()

        if part in {
            "header",
            "headers",
        }:
            return response.header_text

        if part in {
            "all",
            "raw",
            "response",
        }:
            return response.all_text

        return response.body

    # ========================================================
    # DSL
    # ========================================================

    def _evaluate_dsl(
        self,
        expression: str,
        response: ResponseData,
    ) -> bool:

        expression = str(
            expression
        ).strip()

        # ----------------------------------------------------
        # Safe/simple DSL support
        # ----------------------------------------------------

        replacements = {
            "status_code": str(response.status),
            "status": str(response.status),
            "content_length": str(
                len(response.body)
            ),
            "body_length": str(
                len(response.body)
            ),
            "duration": str(
                response.elapsed
            ),
            "response_time": str(
                response.elapsed
            ),
        }

        expr = expression

        for key, value in replacements.items():
            expr = re.sub(
                rf"\b{re.escape(key)}\b",
                value,
                expr,
            )

        # contains("text")
        def contains_repl(match):
            needle = match.group(1)
            return str(
                needle in response.body
            )

        expr = re.sub(
            r'contains\(["\'](.*?)["\']\)',
            contains_repl,
            expr,
            flags=re.IGNORECASE,
        )

        # regex("pattern")
        def regex_repl(match):
            pattern = match.group(1)

            try:
                return str(
                    re.search(
                        pattern,
                        response.body,
                        re.IGNORECASE
                        | re.MULTILINE,
                    )
                    is not None
                )
            except re.error:
                return "False"

        expr = re.sub(
            r'regex\(["\'](.*?)["\']\)',
            regex_repl,
            expr,
            flags=re.IGNORECASE,
        )

        # Handle boolean operators.
        expr = re.sub(
            r"\bAND\b",
            " and ",
            expr,
            flags=re.IGNORECASE,
        )

        expr = re.sub(
            r"\bOR\b",
            " or ",
            expr,
            flags=re.IGNORECASE,
        )

        expr = re.sub(
            r"\bNOT\b",
            " not ",
            expr,
            flags=re.IGNORECASE,
        )

        # Only evaluate the restricted transformed
        # expression containing basic literals/operators.
        if not re.fullmatch(
            r"[\s\d\.\(\)><=!&|+\-*/'\"A-Za-z_]+",
            expr,
        ):
            return False

        try:
            return bool(
                eval(
                    expr,
                    {
                        "__builtins__": {}
                    },
                    {},
                )
            )
        except Exception:
            return False

    # ========================================================
    # SINGLE MATCHER
    # ========================================================

    def _apply_matcher(
        self,
        matcher: Any,
        response: ResponseData,
    ) -> Tuple[bool, str]:

        if not isinstance(
            matcher,
            dict,
        ):
            return False, ""

        matcher_type = str(
            matcher.get(
                "type",
                "",
            )
        ).lower().strip()

        negative = bool(
            matcher.get(
                "negative",
                False,
            )
        )

        # ----------------------------------------------------
        # NUCLEI STATUS
        # ----------------------------------------------------

        if matcher_type in {
            "status",
            "status_code",
            "http_status",
        }:

            value = matcher.get(
                "status",
                matcher.get(
                    "value"
                ),
            )

            values = ensure_list(value)

            try:

                expected = {
                    int(v)
                    for v in values
                }

                matched = (
                    response.status
                    in expected
                )

            except (
                TypeError,
                ValueError,
            ):

                matched = False

            if negative:
                matched = not matched

            return (
                matched,
                f"status={response.status}",
            )

        # ----------------------------------------------------
        # STATUS IN
        # ----------------------------------------------------

        if matcher_type in {
            "status_in",
            "status_any",
        }:

            values = ensure_list(
                matcher.get(
                    "value"
                )
            )

            try:

                expected = {
                    int(v)
                    for v in values
                }

                matched = (
                    response.status
                    in expected
                )

            except (
                TypeError,
                ValueError,
            ):

                matched = False

            if negative:
                matched = not matched

            return (
                matched,
                f"status={response.status}",
            )

        # ----------------------------------------------------
        # WORD / WORDS
        # ----------------------------------------------------

        if matcher_type in {
            "word",
            "words",
            "body_contains",
            "contains",
        }:

            values = matcher.get(
                "words",
                matcher.get(
                    "value"
                ),
            )

            values = [
                str(v)
                for v in ensure_list(values)
            ]

            target = self._matcher_part(
                matcher,
                response,
            )

            condition = str(
                matcher.get(
                    "condition",
                    "or",
                )
            ).lower()

            if condition == "and":

                matched = all(
                    value in target
                    for value in values
                )

            else:

                matched = any(
                    value in target
                    for value in values
                )

            if negative:
                matched = not matched

            if matched:
                return (
                    True,
                    (
                        "word matched: "
                        + ", ".join(values)
                    ),
                )

            return False, ""

        # ----------------------------------------------------
        # REGEX
        # ----------------------------------------------------

        if matcher_type in {
            "regex",
            "body_regex",
        }:

            patterns = matcher.get(
                "regex",
                matcher.get(
                    "value"
                ),
            )

            patterns = [
                str(v)
                for v in ensure_list(
                    patterns
                )
            ]

            target = self._matcher_part(
                matcher,
                response,
            )

            condition = str(
                matcher.get(
                    "condition",
                    "or",
                )
            ).lower()

            results = []

            for pattern in patterns:

                try:

                    results.append(
                        re.search(
                            pattern,
                            target,
                            re.IGNORECASE
                            | re.MULTILINE,
                        )
                        is not None
                    )

                except re.error as exc:

                    logger.debug(
                        "Invalid regex %r: %s",
                        pattern,
                        exc,
                    )

                    results.append(False)

            if condition == "and":
                matched = bool(results) and all(
                    results
                )
            else:
                matched = any(results)

            if negative:
                matched = not matched

            if matched:
                return (
                    True,
                    (
                        "regex matched: "
                        + ", ".join(patterns)
                    ),
                )

            return False, ""

        # ----------------------------------------------------
        # HEADER CONTAINS
        # ----------------------------------------------------

        if matcher_type in {
            "header_contains",
            "header",
        }:

            value = matcher.get(
                "value"
            )

            if isinstance(
                value,
                dict,
            ):

                results = []

                for header_name, expected in (
                    value.items()
                ):

                    actual = response.header(
                        str(header_name)
                    )

                    results.append(
                        actual is not None
                        and str(expected).lower()
                        in actual.lower()
                    )

                matched = all(results)

            else:

                target = response.header_text

                matched = (
                    str(value).lower()
                    in target.lower()
                )

            if negative:
                matched = not matched

            return (
                matched,
                "header condition matched"
                if matched
                else "",
            )

        # ----------------------------------------------------
        # HEADER EXISTS
        # ----------------------------------------------------

        if matcher_type in {
            "header_exists",
            "has_header",
        }:

            value = matcher.get(
                "value",
                matcher.get(
                    "name"
                ),
            )

            matched = (
                response.header(
                    str(value)
                )
                is not None
            )

            if negative:
                matched = not matched

            return (
                matched,
                f"header={value}",
            )

        # ----------------------------------------------------
        # HEADER MISSING
        # ----------------------------------------------------

        if matcher_type in {
            "header_missing",
            "missing_header",
        }:

            value = matcher.get(
                "value",
                matcher.get(
                    "name"
                ),
            )

            matched = (
                response.header(
                    str(value)
                )
                is None
            )

            if negative:
                matched = not matched

            return (
                matched,
                f"missing-header={value}",
            )

        # ----------------------------------------------------
        # BODY NOT CONTAINS
        # ----------------------------------------------------

        if matcher_type in {
            "body_not_contains",
            "not_contains",
        }:

            values = [
                str(v)
                for v in ensure_list(
                    matcher.get(
                        "value"
                    )
                )
            ]

            matched = all(
                value not in response.body
                for value in values
            )

            if negative:
                matched = not matched

            return (
                matched,
                "negative body matcher",
            )

        # ----------------------------------------------------
        # RESPONSE TIME
        # ----------------------------------------------------

        if matcher_type in {
            "time",
            "time_delay",
            "response_time",
        }:

            value = matcher.get(
                "value"
            )

            try:
                matched = (
                    response.elapsed
                    >= float(value)
                )
            except (
                TypeError,
                ValueError,
            ):
                matched = False

            if negative:
                matched = not matched

            return (
                matched,
                (
                    f"response_time="
                    f"{response.elapsed:.3f}s"
                ),
            )

        # ----------------------------------------------------
        # JSON
        # ----------------------------------------------------

        if matcher_type in {
            "json",
            "json_contains",
        }:

            try:
                parsed = json.loads(
                    response.body
                )
            except (
                ValueError,
                TypeError,
            ):
                return False, ""

            value = matcher.get(
                "value"
            )

            matched = False

            if isinstance(
                value,
                dict,
            ) and isinstance(
                parsed,
                dict,
            ):

                matched = True

                for key, expected in (
                    value.items()
                ):

                    if key not in parsed:
                        matched = False
                        break

                    if (
                        expected is not None
                        and parsed[key]
                        != expected
                    ):
                        matched = False
                        break

            if negative:
                matched = not matched

            return (
                matched,
                "JSON condition matched"
                if matched
                else "",
            )

        # ----------------------------------------------------
        # DSL
        # ----------------------------------------------------

        if matcher_type == "dsl":

            expressions = matcher.get(
                "dsl",
                matcher.get(
                    "value"
                ),
            )

            expressions = ensure_list(
                expressions
            )

            results = [
                self._evaluate_dsl(
                    expression,
                    response,
                )
                for expression in expressions
            ]

            condition = str(
                matcher.get(
                    "condition",
                    "or",
                )
            ).lower()

            if condition == "and":
                matched = bool(results) and all(
                    results
                )
            else:
                matched = any(results)

            if negative:
                matched = not matched

            return (
                matched,
                "DSL condition matched"
                if matched
                else "",
            )

        # ----------------------------------------------------
        # Unknown matcher
        # ----------------------------------------------------

        logger.debug(
            "Unknown matcher type: %s",
            matcher_type,
        )

        return False, ""

    # ========================================================
    # MATCH REQUEST
    # ========================================================

    def _match_request(
        self,
        request_data: Dict[str, Any],
        response: ResponseData,
    ) -> Tuple[bool, List[str]]:

        matchers = request_data.get(
            "matchers",
            [],
        )

        if not isinstance(
            matchers,
            list,
        ):
            return False, []

        if not matchers:
            return False, []

        mode = str(
            request_data.get(
                "matcher_condition",
                "or",
            )
        ).lower()

        if mode not in {
            "and",
            "or",
        }:
            mode = "or"

        results = []
        evidence = []

        for matcher in matchers:

            matched, evidence_text = (
                self._apply_matcher(
                    matcher,
                    response,
                )
            )

            results.append(matched)

            if matched and evidence_text:
                evidence.append(
                    evidence_text
                )

        if mode == "and":

            matched = (
                bool(results)
                and all(results)
            )

        else:

            matched = any(results)

        return matched, evidence

    # ========================================================
    # EXTRACTORS
    # ========================================================

    def _extract_values(
        self,
        response: ResponseData,
        extractors: Any,
    ) -> Dict[str, Any]:

        extracted: Dict[str, Any] = {}

        if not isinstance(
            extractors,
            list,
        ):
            return extracted

        for extractor in extractors:

            if not isinstance(
                extractor,
                dict,
            ):
                continue

            extractor_type = str(
                extractor.get(
                    "type",
                    "",
                )
            ).lower()

            name = str(
                extractor.get(
                    "name",
                    "",
                )
            )

            if not name:
                continue

            value = extractor.get(
                "value",
                extractor.get(
                    "regex",
                ),
            )

            # ------------------------------------------------
            # HEADER
            # ------------------------------------------------

            if extractor_type == "header":

                header_value = (
                    response.header(
                        str(value)
                    )
                )

                if header_value is not None:
                    extracted[name] = (
                        header_value
                    )

            # ------------------------------------------------
            # REGEX
            # ------------------------------------------------

            elif extractor_type in {
                "regex",
                "regex_group",
            }:

                patterns = ensure_list(
                    value
                )

                for pattern in patterns:

                    try:

                        match = re.search(
                            str(pattern),
                            response.body,
                            re.IGNORECASE
                            | re.MULTILINE,
                        )

                        if not match:
                            continue

                        if match.groups():
                            extracted[name] = (
                                match.group(1)
                            )
                        else:
                            extracted[name] = (
                                match.group(0)
                            )

                        break

                    except re.error:
                        continue

            # ------------------------------------------------
            # JSON
            # ------------------------------------------------

            elif extractor_type == "json":

                try:

                    parsed = json.loads(
                        response.body
                    )

                except (
                    ValueError,
                    TypeError,
                ):
                    continue

                current = parsed

                for part in str(
                    value
                ).split("."):

                    if isinstance(
                        current,
                        dict,
                    ):

                        current = current.get(
                            part
                        )

                    else:

                        current = None
                        break

                if current is not None:
                    extracted[name] = current

            # ------------------------------------------------
            # WORD
            # ------------------------------------------------

            elif extractor_type == "word":

                if str(value) in response.body:

                    extracted[name] = str(
                        value
                    )

        return extracted

    # ========================================================
    # FINDING KIND
    # ========================================================

    def _resolve_kind(
        self,
        template: Dict[str, Any],
        evidence: List[str],
        response: ResponseData,
    ) -> str:

        classification = template.get(
            "classification",
            {},
        )

        if isinstance(
            classification,
            dict,
        ):

            declared = classification.get(
                "kind"
            )

            if declared in VALID_KINDS:
                return declared

        explicit_kind = template.get(
            "kind"
        )

        if explicit_kind in VALID_KINDS:
            return explicit_kind

        return "Possible"

    # ========================================================
    # CONFIDENCE
    # ========================================================

    def _calculate_confidence(
        self,
        template: Dict[str, Any],
        evidence: List[str],
        response: ResponseData,
        extracted: Dict[str, Any],
    ) -> float:

        confidence = 0.50

        if evidence:
            confidence += 0.15

        if len(evidence) >= 2:
            confidence += 0.10

        if extracted:
            confidence += 0.15

        kind = self._resolve_kind(
            template,
            evidence,
            response,
        )

        if kind == "Verified":
            confidence += 0.20

        if self._is_blocked(response):
            confidence -= 0.30

        return max(
            0.0,
            min(
                1.0,
                confidence,
            ),
        )

    # ========================================================
    # REQUEST EXECUTION
    # ========================================================

    def _execute_request(
        self,
        request_data: Dict[str, Any],
        context: Dict[str, Any],
    ) -> Tuple[
        Optional[ResponseData],
        List[str],
        Dict[str, Any],
    ]:

        method = str(
            self._substitute(
                request_data.get(
                    "method",
                    "GET",
                ),
                context,
            )
        ).upper()

        path = str(
            self._substitute(
                request_data.get(
                    "path",
                    "/",
                ),
                context,
            )
        )

        url = self._build_url(
            path,
            context,
        )

        headers = self._substitute(
            request_data.get(
                "headers",
                {},
            ),
            context,
        )

        body = self._substitute(
            request_data.get(
                "body",
            ),
            context,
        )

        params = self._substitute(
            request_data.get(
                "params",
                {},
            ),
            context,
        )

        response = self._request(
            method=method,
            url=url,
            headers=headers,
            body=body,
            params=params,
        )

        if response is None:
            return None, [], {}

        matched, evidence = (
            self._match_request(
                request_data,
                response,
            )
        )

        extracted = {}

        # Extractors are useful even when the
        # request itself didn't produce a finding.
        extracted = self._extract_values(
            response,
            request_data.get(
                "extractors",
                [],
            ),
        )

        return (
            response,
            evidence if matched else [],
            extracted,
        )

    # ========================================================
    # TEMPLATE EXECUTION
    # ========================================================

    def _execute_template(
        self,
        template: Dict[str, Any],
    ) -> List[Dict[str, Any]]:

        template_id = str(
            template.get(
                "id",
                "unknown",
            )
        )

        template_name = str(
            template.get(
                "name",
                template_id,
            )
        )

        requests_data = template.get(
            "requests",
            [],
        )

        if not requests_data:
            return []

        local_context = dict(
            self.context
        )

        stage_variables: Dict[
            str,
            Any,
        ] = {}

        template_findings = []

        for index, request_data in enumerate(
            requests_data
        ):

            if not isinstance(
                request_data,
                dict,
            ):
                continue

            request_context = {
                **local_context,
                **stage_variables,
            }

            (
                response,
                evidence,
                extracted,
            ) = self._execute_request(
                request_data,
                request_context,
            )

            if response is None:
                continue

            # ------------------------------------------------
            # Stage variables
            # ------------------------------------------------

            stage_variables.update(
                extracted
            )

            local_context.update(
                extracted
            )

            # ------------------------------------------------
            # No matcher hit
            # ------------------------------------------------

            if not evidence:
                continue

            confidence = (
                self._calculate_confidence(
                    template,
                    evidence,
                    response,
                    extracted,
                )
            )

            kind = self._resolve_kind(
                template,
                evidence,
                response,
            )

            finding = {
                "id": str(
                    uuid.uuid4()
                ),

                "scan_id": self.scan_id,

                "template_id": template_id,

                "name": template_name,

                "title": template_name,

                "description": template.get(
                    "description",
                    "",
                ),

                "category": template.get(
                    "category",
                    "general",
                ),

                "severity": template.get(
                    "severity",
                    "Informational",
                ),

                "kind": kind,

                "confidence": round(
                    confidence,
                    3,
                ),

                "verified": (
                    kind == "Verified"
                    and confidence >= 0.70
                ),

                "url": response.url,

                "method": response.method,

                "status_code": response.status,

                "evidence": evidence,

                "extracted": extracted,

                "response_time": (
                    response.elapsed
                ),

                "stage_index": index,

                "template_file": template.get(
                    "_file"
                ),

                "tags": template.get(
                    "tags",
                    [],
                ),

                "impact": template.get(
                    "impact",
                    "",
                ),

                "remediation": template.get(
                    "recommendation",
                    "",
                ),

                "timestamp": utc_now(),
            }

            template_findings.append(
                finding
            )

            # ------------------------------------------------
            # Continue multi-stage templates unless
            # explicitly configured to stop.
            # ------------------------------------------------

            stop = request_data.get(
                "stop_at_first_match",
                False,
            )

            if stop:
                break

        return template_findings

    # ========================================================
    # TEMPLATE WORKER
    # ========================================================

    def _template_worker(
        self,
        template: Dict[str, Any],
    ) -> List[Dict[str, Any]]:

        try:

            return self._execute_template(
                template
            )

        except Exception as exc:

            self._increment_errors()

            logger.exception(
                "Template %s failed: %s",
                template.get(
                    "id",
                    "unknown",
                ),
                exc,
            )

            return []

    # ========================================================
    # AUTHENTICATION
    # ========================================================

    def login(self) -> bool:

        if self.skip_auth:
            return False

        if not self.username or not self.password:
            return False

        self._log(
            "[INFO] Username/password supplied, "
            "but no generic login endpoint is assumed."
        )

        return False

    # ========================================================
    # FINGERPRINT
    # ========================================================

    def fingerprint(self) -> Dict[str, Any]:

        if self.no_fingerprint:
            return {}

        response = self._request(
            method="GET",
            url=self.base_url,
        )

        if response is None:
            return {}

        technologies = []

        headers_lower = {
            key.lower(): value
            for key, value in response.headers.items()
        }

        server = headers_lower.get(
            "server"
        )

        powered_by = headers_lower.get(
            "x-powered-by"
        )

        if server:
            technologies.append(
                server
            )

        if powered_by:
            technologies.append(
                powered_by
            )

        self.fingerprint_data = {
            "status": response.status,
            "server": server,
            "powered_by": powered_by,
            "technologies": technologies,
            "url": response.url,
        }

        return self.fingerprint_data

    # ========================================================
    # DEDUPLICATION
    # ========================================================

    def _deduplicate_findings(
        self,
        findings: List[Dict[str, Any]],
    ) -> List[Dict[str, Any]]:

        unique = []
        seen = set()

        for finding in findings:

            key = (
                finding.get(
                    "template_id"
                ),
                finding.get(
                    "url"
                ),
                finding.get(
                    "method"
                ),
                finding.get(
                    "status_code"
                ),
                finding.get(
                    "kind"
                ),
                tuple(
                    finding.get(
                        "evidence",
                        [],
                    )
                ),
            )

            if key in seen:
                continue

            seen.add(key)
            unique.append(finding)

        return unique

    # ========================================================
    # SCAN
    # ========================================================

    def scan(
        self,
    ) -> ScanResult:

        result = ScanResult()

        result.scan_id = self.scan_id
        result.target = self.base_url

        self.start_time = utc_now()
        result.start_time = self.start_time

        started = time.monotonic()

        self.findings = []

        self.requests_sent = 0
        self.errors_count = 0

        # ----------------------------------------------------
        # LOAD TEMPLATES
        # ----------------------------------------------------

        self.load_templates()

        result.templates_loaded = len(
            self.templates
        )

        if not self.templates:

            self._log(
                "[WARN] No templates loaded."
            )

            result.end_time = utc_now()

            result.duration = (
                time.monotonic()
                - started
            )

            result.request_count = (
                self.requests_sent
            )

            result.error_count = (
                self.errors_count
            )

            return result

        # ----------------------------------------------------
        # FINGERPRINT
        # ----------------------------------------------------

        if not self.no_fingerprint:

            try:

                self.fingerprint()

            except Exception as exc:

                logger.debug(
                    "Fingerprint failed: %s",
                    exc,
                )

        # ----------------------------------------------------
        # START
        # ----------------------------------------------------

        self._log(
            "[*] Starting scan: "
            f"{self.base_url}"
        )

        # ----------------------------------------------------
        # EXECUTE
        # ----------------------------------------------------

        with ThreadPoolExecutor(
            max_workers=self.max_workers
        ) as executor:

            futures = {
                executor.submit(
                    self._template_worker,
                    template,
                ): template
                for template in self.templates
            }

            for future in as_completed(
                futures
            ):

                template = futures[
                    future
                ]

                result.templates_executed += 1

                try:

                    findings = future.result()

                    if findings:
                        self.findings.extend(
                            findings
                        )

                except Exception as exc:

                    self._increment_errors()

                    logger.exception(
                        "Worker failed for %s: %s",
                        template.get(
                            "id",
                            "unknown",
                        ),
                        exc,
                    )

        # ----------------------------------------------------
        # DEDUP
        # ----------------------------------------------------

        self.findings = (
            self._deduplicate_findings(
                self.findings
            )
        )

        # ----------------------------------------------------
        # RESULT
        # ----------------------------------------------------

        self.end_time = utc_now()

        result.end_time = self.end_time

        result.duration = (
            time.monotonic()
            - started
        )

        result.request_count = (
            self.requests_sent
        )

        result.error_count = (
            self.errors_count
        )

        result.findings = list(
            self.findings
        )

        result.fingerprint = dict(
            self.fingerprint_data
        )

        # ----------------------------------------------------
        # SUMMARY
        # ----------------------------------------------------

        self._log(
            "[+] Scan completed"
        )

        self._log(
            f"[+] Templates: "
            f"{result.templates_loaded}"
        )

        self._log(
            f"[+] Requests: "
            f"{result.request_count}"
        )

        self._log(
            f"[+] Findings: "
            f"{len(result.findings)}"
        )

        self._log(
            f"[+] Errors: "
            f"{result.error_count}"
        )

        self._log(
            f"[+] Duration: "
            f"{result.duration:.2f}s"
        )

        return result

    # ========================================================
    # COMPATIBILITY ALIASES
    # ========================================================

    def run(self) -> ScanResult:
        return self.scan()

    def start(self) -> ScanResult:
        return self.scan()


# ============================================================
# PUBLIC HELPER
# ============================================================

def scan(
    url: str,
    **kwargs: Any,
) -> ScanResult:

    scanner = Scanner(
        url,
        **kwargs,
    )

    return scanner.scan()


