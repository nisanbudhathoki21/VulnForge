def severity_color(
    severity: str,
) -> str:
    value = str(
        severity
    ).lower()

    if value == "critical":
        return Fore.RED

    if value == "high":
        return Fore.RED

    if value == "medium":
        return Fore.YELLOW

    if value == "low":
        return Fore.CYAN

    return Fore.WHITE


