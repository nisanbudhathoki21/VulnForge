def now() -> str:
    """Return an ISO-8601 UTC timestamp."""
    return datetime.now(timezone.utc).isoformat()


# ============================================================
# SIGNAL HANDLING
# ============================================================

def _handle_signal(signum: int, frame: Any) -> None:
    """Gracefully request scan cancellation."""

    if STOP_EVENT.is_set():
        print(
            f"\n{Fore.RED}Forced exit.{Style.RESET_ALL}"
        )
        raise KeyboardInterrupt

    STOP_EVENT.set()

    print(
        f"\n{Fore.YELLOW}"
        "Cancellation requested. Waiting for active work..."
        f"{Style.RESET_ALL}"
    )


def install_signal_handlers() -> None:
    """Install Ctrl-C / termination handlers."""

    try:
        signal.signal(
            signal.SIGINT,
            _handle_signal,
        )
    except Exception:
        pass

    try:
        signal.signal(
            signal.SIGTERM,
            _handle_signal,
        )
    except Exception:
        pass


