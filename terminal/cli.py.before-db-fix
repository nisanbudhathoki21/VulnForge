def finding_name(
    finding: Dict[str, Any],
) -> str:

    return str(
        finding.get(
            "name",
            finding.get(
                "title",
                finding.get(
                    "template_name",
                    finding.get(
                        "template_id",
                        "Unnamed finding",
                    ),
                ),
            ),
        )
    )


def finding_severity(
    finding: Dict[str, Any],
) -> str:

    return str(
        finding.get(
            "severity",
            "informational",
        )
    ).upper()


def finding_evidence(
    finding: Dict[str, Any],
) -> Dict[str, Any]:

    evidence = finding.get(
        "evidence",
        {},
    )

    if isinstance(
        evidence,
        dict,
    ):
        return evidence

    return {}


