# ============================================================
# PRINT FINDINGS
# ============================================================

def print_findings(
    findings: List[Dict[str, Any]],
) -> None:

    if not findings:

        print(
            f"\n{Fore.GREEN}"
            "✓ No verified findings"
            f"{Style.RESET_ALL}"
        )

        return

    print(
        f"\n{Fore.YELLOW}"
        f"Findings: {len(findings)}"
        f"{Style.RESET_ALL}"
    )

    for index, finding in enumerate(
        findings,
        1,
    ):

        severity = finding_severity(
            finding
        )

        color = severity_color(
            severity
        )

        name = finding_name(
            finding
        )

        evidence = finding_evidence(
            finding
        )

        print(
            f"\n  {color}"
            f"[{severity}]"
            f"{Style.RESET_ALL} "
            f"{index}. {name}"
        )

        method = evidence.get(
            "method",
            finding.get(
                "method",
                "?",
            ),
        )

        url = evidence.get(
            "url",
            finding.get(
                "url",
                "",
            ),
        )

        status = evidence.get(
            "status",
            evidence.get(
                "status_code",
                finding.get(
                    "status_code",
                    "N/A",
                ),
            ),
        )

        print(
            f"      {method} {url}"
        )

        print(
            f"      Status: {status}"
        )

        kind = finding.get(
            "kind"
        )

        confidence = finding.get(
            "confidence"
        )

        if kind:
            print(
                f"      Kind: {kind}"
            )

        if confidence is not None:
            print(
                f"      Confidence: {confidence}"
            )


