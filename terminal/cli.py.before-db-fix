# ============================================================
# TARGET LOADING
# ============================================================

def load_targets(
    args: argparse.Namespace,
) -> List[str]:
    """Resolve CLI target arguments into a target list."""

    targets: List[str] = []

    if args.url:
        targets.append(args.url.strip())

    if args.list:
        path = Path(args.list)

        if not path.exists():
            raise FileNotFoundError(
                f"Target list not found: {path}"
            )

        for line in path.read_text(
            encoding="utf-8"
        ).splitlines():

            line = line.strip()

            if not line:
                continue

            if line.startswith("#"):
                continue

            targets.append(line)

    # Remove duplicates while preserving order.
    unique: List[str] = []
    seen = set()

    for target in targets:

        if target in seen:
            continue

        seen.add(target)
        unique.append(target)

    return unique


# ============================================================
# URL NORMALIZATION
# ============================================================

def normalize_target(url: str) -> str:
    """Normalize a target URL."""

    value = str(url).strip()

    if not value:
        return value

    if not value.startswith(
        (
            "http://",
            "https://",
        )
    ):
        value = "https://" + value

    return value.rstrip("/")


# ============================================================
# SCANNER ADAPTER
# ============================================================

def scan_target(
    target: str,
    *,
    quiet: bool = True,
    template_dir: str = "templates",
    max_workers: int = 5,
    proxy_file: Optional[str] = None,
    country: Optional[str] = None,
    rate_limit: float = 0,
    delay: float = 0,
    jitter: float = 0,
    exploit: bool = False,
    full: bool = False,
    username: Optional[str] = None,
    password: Optional[str] = None,
    timeout: int = 10,
    skip_priv: bool = False,
    skip_auth: bool = False,
    no_fingerprint: bool = False,
) -> Dict[str, Any]:
    """
    Single CLI adapter around the canonical Scanner.

    IMPORTANT:
        There is no second scanner implementation here.

        terminal/cli.py -> engine.scanner.Scanner
    """

    target = normalize_target(target)

    scanner = Scanner(
        url=target,
        quiet=quiet,
        template_dir=template_dir,
        max_workers=max_workers,
        proxy_file=proxy_file,
        country=country,
        rate_limit=rate_limit,
        delay=delay,
        jitter=jitter,
        exploit=exploit,
        username=username,
        password=password,
        timeout=timeout,
        skip_priv=skip_priv,
        skip_auth=skip_auth,
        no_fingerprint=no_fingerprint,
    )

    result = scanner.scan()

    if hasattr(result, "to_dict"):
        data = result.to_dict()
    elif isinstance(result, dict):
        data = dict(result)
    else:
        data = {}

    # Preserve useful scanner metadata.
    data.setdefault(
        "scan_id",
        getattr(
            scanner,
            "scan_id",
            None,
        ),
    )

    data.setdefault(
        "target",
        target,
    )

    data.setdefault(
        "url",
        target,
    )

    data.setdefault(
        "findings",
        [],
    )

    data.setdefault(
        "request_count",
        getattr(
            scanner,
            "requests_sent",
            0,
        ),
    )

    data.setdefault(
        "error_count",
        getattr(
            scanner,
            "errors_count",
            0,
        ),
    )

    data.setdefault(
        "fingerprint",
        getattr(
            scanner,
            "fingerprint_data",
            {},
        ),
    )

    data["full"] = full

    return data


# ============================================================
# FINGERPRINT
# ============================================================

def run_fingerprint(
    target: str,
    *,
    quiet: bool = False,
) -> Dict[str, Any]:
    """Run the project's fingerprint module."""

    try:

        result = fingerprint_target(
            target,
            quiet=quiet,
        )

        if isinstance(result, dict):
            return result

        return {}

    except Exception as exc:

        if not quiet:
            print(
                f"{Fore.YELLOW}"
                f"[WARN] Fingerprint failed: {exc}"
                f"{Style.RESET_ALL}"
            )

        return {
            "error": str(exc)
        }


# ============================================================
# SINGLE TARGET
# ============================================================

def scan_one_target(
    target: str,
    args: argparse.Namespace,
) -> Dict[str, Any]:
    """Scan one target and persist the result."""

    target = normalize_target(target)

    result: Dict[str, Any] = {
        "url": target,
        "target": target,
        "scan_id": None,
        "start_time": now(),
        "end_time": None,
        "findings": [],
        "fingerprint": {},
        "database_saved": False,
        "error": None,
    }

    started = time.monotonic()

    try:

        # ----------------------------------------------------
        # FINGERPRINT
        # ----------------------------------------------------

        if not args.no_fingerprint:

            if not args.quiet:
                print(
                    f"{Fore.BLUE}"
                    f"[FINGERPRINT]"
                    f"{Style.RESET_ALL} "
                    f"{target}"
                )

            result["fingerprint"] = run_fingerprint(
                target,
                quiet=True,
            )

        # ----------------------------------------------------
        # STOP CHECK
        # ----------------------------------------------------

        if STOP_EVENT.is_set():

            result["error"] = "Scan cancelled"
            return result

        # ----------------------------------------------------
        # SCANNER
        # ----------------------------------------------------

        scan_result = scan_target(
            target,
            quiet=True,
            template_dir=args.templates,
            max_workers=max(
                1,
                min(
                    args.threads,
                    20,
                ),
            ),
            proxy_file=(
                args.proxy_file
                if args.proxy_file
                and not args.no_proxy
                else None
            ),
            country=args.country,
            rate_limit=args.rate_limit,
            delay=args.delay,
            jitter=args.jitter,
            exploit=args.exploit,
            full=args.full,
            username=args.username,
            password=args.password,
            timeout=args.timeout,
            skip_priv=args.no_priv,
            skip_auth=args.no_auth,
            no_fingerprint=True,
        )

        if not isinstance(
            scan_result,
            dict,
        ):
            scan_result = {}

        # ----------------------------------------------------
        # MERGE SCANNER RESULT
        # ----------------------------------------------------

        for key, value in scan_result.items():

            if key == "fingerprint" and result.get(
                "fingerprint"
            ):
                continue

            result[key] = value

        result["scan_id"] = scan_result.get(
            "scan_id"
        )

        result["findings"] = (
            scan_result.get(
                "findings",
                [],
            )
            or []
        )

        result["request_count"] = scan_result.get(
            "request_count",
            0,
        )

        result["error_count"] = scan_result.get(
            "error_count",
            0,
        )

        result["end_time"] = now()

        # ----------------------------------------------------
        # SQLITE
        # ----------------------------------------------------

        try:

            init_db()

            saved = persist_scan(
                result
            )

            result["database_saved"] = bool(
                saved
            )

        except Exception as exc:

            result["database_saved"] = False

            if args.debug:
                print(
                    f"{Fore.YELLOW}"
                    f"[DEBUG] Database error: {exc}"
                    f"{Style.RESET_ALL}"
                )

    except KeyboardInterrupt:

        result["error"] = "Interrupted by user"

    except Exception as exc:

        result["error"] = str(exc)

        if args.debug:
            import traceback

            traceback.print_exc()

    finally:

        if not result.get("end_time"):
            result["end_time"] = now()

        result["duration"] = (
            time.monotonic()
            - started
        )

    return result


