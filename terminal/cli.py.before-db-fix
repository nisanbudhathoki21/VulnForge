    except Exception as exc:
        print(
            f"{Fore.RED}"
            f"Unable to read scan: {exc}"
            f"{Style.RESET_ALL}"
        )
        return

    if not scan_item:

        print(
            f"{Fore.RED}"
            f"Scan '{scan_id}' not found."
            f"{Style.RESET_ALL}"
        )

        return

    print(
        json.dumps(
            scan_item,
            indent=2,
            default=str,
        )
    )


# ============================================================
# JSON OUTPUT
# ============================================================

def save_json(
    results: Any,
    path: str,
) -> None:

    output_path = Path(path)

    output_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    with output_path.open(
        "w",
        encoding="utf-8",
    ) as handle:

        json.dump(
            results,
            handle,
            indent=2,
            default=str,
        )

    print(
        f"{Fore.GREEN}"
        f"[+] JSON saved: {output_path}"
        f"{Style.RESET_ALL}"
    )


# ============================================================
# CSV OUTPUT
# ============================================================

def save_csv(
    results: List[Dict[str, Any]],
    path: str,
) -> None:

    output_path = Path(path)

    output_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    rows: List[Dict[str, Any]] = []

    for result in results:

        target = result.get(
            "url",
            result.get(
                "target",
                "",
            ),
        )

        findings = result.get(
            "findings",
            [],
        ) or []

        if not findings:

            rows.append(
                {
                    "target": target,
                    "scan_id": result.get(
                        "scan_id",
                        "",
                    ),
                    "severity": "",
                    "name": "",
                    "kind": "",
                    "confidence": "",
                    "method": "",
                    "url": "",
                    "status": "",
                }
            )

            continue

        for finding in findings:

            evidence = finding_evidence(
                finding
            )

            rows.append(
                {
                    "target": target,
                    "scan_id": result.get(
                        "scan_id",
                        "",
                    ),
                    "severity": finding.get(
                        "severity",
                        "",
                    ),
                    "name": finding_name(
                        finding
                    ),
                    "kind": finding.get(
                        "kind",
                        "",
                    ),
                    "confidence": finding.get(
                        "confidence",
                        "",
                    ),
                    "method": evidence.get(
                        "method",
                        finding.get(
                            "method",
                            "",
                        ),
                    ),
                    "url": evidence.get(
                        "url",
                        finding.get(
                            "url",
                            "",
                        ),
                    ),
                    "status": evidence.get(
                        "status",
                        evidence.get(
                            "status_code",
                            finding.get(
                                "status_code",
                                "",
                            ),
                        ),
                    ),
                }
            )

    fieldnames = [
        "target",
        "scan_id",
        "severity",
        "name",
        "kind",
        "confidence",
        "method",
        "url",
        "status",
    ]

    with output_path.open(
        "w",
        newline="",
        encoding="utf-8",
    ) as handle:

        writer = csv.DictWriter(
            handle,
            fieldnames=fieldnames,
        )

        writer.writeheader()
        writer.writerows(rows)

    print(
        f"{Fore.GREEN}"
        f"[+] CSV saved: {output_path}"
        f"{Style.RESET_ALL}"
    )


# ============================================================
# AI REPORT
# ============================================================

def generate_ai_report(
    results: List[Dict[str, Any]],
    model: str,
    base_url: str,
) -> Optional[str]:
    """
    Optional Ollama integration.

    This is deliberately outside the scanner.
    The scanner only discovers findings.
    """

    try:
        import requests
    except ImportError:
        return None

    findings: List[Dict[str, Any]] = []

    for result in results:
        findings.extend(
            result.get(
                "findings",
                [],
            )
            or []
        )

    if not findings:
        return (
            "No findings were produced by VulnForge."
        )

    prompt = (
        "Analyze the following authorized security scan findings. "
        "Summarize the important issues, likely impact, confidence, "
        "and recommended remediation. Do not invent vulnerabilities.\n\n"
        + json.dumps(
            findings,
            indent=2,
            default=str,
        )
    )

    try:

        response = requests.post(
            base_url.rstrip("/")
            + "/api/generate",
            json={
                "model": model,
                "prompt": prompt,
                "stream": False,
            },
            timeout=120,
        )

        response.raise_for_status()

        data = response.json()

        return data.get(
            "response"
        )

    except Exception as exc:

        print(
            f"{Fore.YELLOW}"
            f"[WARN] AI report failed: {exc}"
            f"{Style.RESET_ALL}"
        )

        return None


# ============================================================
# MAIN SCAN LOOP
# ============================================================

def run(args: argparse.Namespace) -> int:

    STOP_EVENT.clear()

    install_signal_handlers()

    # --------------------------------------------------------
    # HISTORY
    # --------------------------------------------------------

    if args.history:

        show_history()
        return 0

    # --------------------------------------------------------
    # SCAN DETAILS
    # --------------------------------------------------------

    if args.scan_id:

        show_scan(
            args.scan_id
        )
        return 0

    # --------------------------------------------------------
    # TARGETS
    # --------------------------------------------------------

    try:
        targets = load_targets(
            args
        )
    except Exception as exc:

        print(
            f"{Fore.RED}"
            f"[ERROR] {exc}"
            f"{Style.RESET_ALL}",
            file=sys.stderr,
        )

        return 2

    if not targets:

        print(
            f"{Fore.RED}"
            "No target supplied. Use -u URL or -l LIST."
            f"{Style.RESET_ALL}",
            file=sys.stderr,
        )

        return 2

    # --------------------------------------------------------
    # VALIDATE SETTINGS
    # --------------------------------------------------------

    if args.threads < 1:
        args.threads = 1

    if args.timeout < 1:
        args.timeout = 1

    if args.rate_limit < 0:
        args.rate_limit = 0

    if args.delay < 0:
        args.delay = 0

    if args.jitter < 0:
        args.jitter = 0

    # --------------------------------------------------------
    # BANNER
    # --------------------------------------------------------

    if not args.quiet:
        print_banner()

        print(
            f"[*] Targets : "
            f"{len(targets)}"
        )

        print(
            f"[*] Threads : "
            f"{args.threads}"
        )

        print(
            f"[*] Timeout : "
            f"{args.timeout}s"
        )

        print()

    # --------------------------------------------------------
    # SCAN
    # --------------------------------------------------------

    results: List[Dict[str, Any]] = []

    global_started = time.monotonic()

    for index, target in enumerate(
        targets,
        1,
    ):

        if STOP_EVENT.is_set():
            break

        if len(targets) > 1 and not args.quiet:

            print(
                f"\n{Fore.MAGENTA}"
                f"===== Target {index}/{len(targets)} ====="
                f"{Style.RESET_ALL}"
            )

        started = time.monotonic()

        result = scan_one_target(
            target,
            args,
        )

        elapsed = (
            time.monotonic()
            - started
        )

        results.append(
            result
        )

        if not args.quiet:

            print_fingerprint(
                result.get(
                    "fingerprint",
                    {},
                )
            )

            print_findings(
                result.get(
                    "findings",
                    [],
                )
                or []
            )

            print_summary(
                result,
                elapsed,
            )

    # --------------------------------------------------------
    # JSON OUTPUT
    # --------------------------------------------------------

    if args.output:

        if len(results) == 1:
            payload: Any = results[0]
        else:
            payload = results

        save_json(
            payload,
            args.output,
        )

    # --------------------------------------------------------
    # CSV OUTPUT
    # --------------------------------------------------------

    if args.csv:

        save_csv(
            results,
            args.csv,
        )

    # --------------------------------------------------------
    # AI
    # --------------------------------------------------------

    if args.ai:

        report = generate_ai_report(
            results,
            args.ai_model,
            args.ai_url,
        )

        if report:

            print(
                f"\n{Fore.CYAN}"
                "VulnForge AI Report"
                f"{Style.RESET_ALL}\n"
            )

            print(report)

    # --------------------------------------------------------
    # JSON TERMINAL OUTPUT
    # --------------------------------------------------------

    if args.json:

        print(
            json.dumps(
                results
                if len(results) != 1
                else results[0],
                indent=2,
                default=str,
            )
        )

    # --------------------------------------------------------
    # FINAL SUMMARY
    # --------------------------------------------------------

    if not args.quiet:

        total_findings = sum(
            len(
                result.get(
                    "findings",
                    [],
                )
                or []
            )
            for result in results
        )

        saved_count = sum(
            1
            for result in results
            if result.get(
                "database_saved"
            )
        )

        total_elapsed = (
            time.monotonic()
            - global_started
        )

        print(
            f"{Fore.CYAN}"
            "╭──────────────────────────────────────────────╮"
            f"{Style.RESET_ALL}"
        )

        print(
            f"{Fore.CYAN}"
            "│                 SUMMARY                      │"
            f"{Style.RESET_ALL}"
        )

        print(
            f"{Fore.CYAN}"
            "╰──────────────────────────────────────────────╯"
            f"{Style.RESET_ALL}"
        )

        print(
            f"Targets     : {len(results)}"
        )

        print(
            f"Findings    : {total_findings}"
        )

        print(
            f"Duration    : {total_elapsed:.2f}s"
        )

        print(
            f"DB Saved    : "
            f"{saved_count}/{len(results)}"
        )

        if STOP_EVENT.is_set():

            print(
                f"{Fore.YELLOW}"
                "⚠ Scan cancelled."
                f"{Style.RESET_ALL}"
            )

        elif total_findings == 0:

            print(
                f"{Fore.GREEN}"
                "✓ VulnForge finished."
                f"{Style.RESET_ALL}"
            )

        else:

            print(
                f"{Fore.YELLOW}"
                "⚠ VulnForge finished with findings."
                f"{Style.RESET_ALL}"
            )

    return 0


# ============================================================
# PUBLIC ENTRYPOINT
# ============================================================

def main(
    argv: Optional[List[str]] = None,
) -> int:

    parser = build_parser()

    args = parser.parse_args(
        argv
    )

    return run(
        args
    )


# ============================================================
# MODULE ENTRYPOINT
# ============================================================

if __name__ == "__main__":
    raise SystemExit(
        main()
    )
