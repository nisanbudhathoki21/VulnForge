# ==========================================
#  VulnForge v2.0 - Official Git Ignore
# ==========================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite Databases & WAL journal files (keep scans local/private)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
vulnforge.db

# Generated Security Assessment Reports
*.pdf
*.md
!README.md
reports/
vulnforge_reports/
test_report.*
mock_report.*
*.xml

# Log files & runtime telemetry
*.log
requests_log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Packaging, builds & setuptools
build/
dist/
*.egg-info/
.eggs/
*.egg

# Temporary installer / helper scripts
apply_update.py
install_full.py
install_all_modules.py
make_installer.py
fix_modules.py
setup_live_dashboard.py
update_with_verifier.py
update_cli_db.py

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
